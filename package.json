{
  "name": "boutique-cartes-cadeaux",
  "version": "1.0.0",
  "private": true,
  "description": "Boutique 3D de cartes cadeaux numériques : 3 boutiques, paiement PayPal côté serveur, livraison automatique des codes par e-mail (Brevo).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "generer-cle": "node scripts/generer-cle.js",
    "importer-stock": "node scripts/importer-stock.js",
    "verifier-config": "node -e \"const c=require('./src/catalogue').chargerConfig();for(const[s,b]of Object.entries(c.boutiques))console.log(b.nomCourt+' : '+b.sections.reduce((n,x)=>n+x.produits.length,0)+' articles')\"",
    "export-apercu": "node scripts/export-apercu.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "nodemailer": "^6.10.0",
    "three": "0.170.0"
  }
}
