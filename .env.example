# =====================================================================
#  Variables à renseigner sur ton hébergeur (Render : Environment ;
#  hPanel : Node.js > Variables d'environnement) ou dans un fichier .env
#  en local. NE JAMAIS mettre ces valeurs dans le code ni sur GitHub.
# =====================================================================

# --- Site ---
NODE_ENV=production
PORT=3000
# Adresse publique du site, en https:// (sert aux balises Open Graph og:image / og:url)
SITE_URL=https://www.ton-domaine.fr
# Redirige automatiquement http:// vers https:// (true en production)
FORCE_HTTPS=true

# --- PayPal (developer.paypal.com > Apps & Credentials) ---
# live = VRAIS paiements (par défaut en production). sandbox = essais avec de faux comptes.
# ⚠ Les clés live et sandbox sont différentes : prends les clés de l'onglet « Live » sur developer.paypal.com
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook à créer dans ton app PayPal, URL : https://www.ton-domaine.fr/api/paypal/webhook
# Événements : PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.REFUNDED, PAYMENT.CAPTURE.REVERSED
PAYPAL_WEBHOOK_ID=

# --- E-MAILS (Brevo) -----------------------------------------------------------------
# 1) BREVO_API_KEY : clé API Brevo (commence par xkeysib-). app.brevo.com > SMTP & API > onglet « Clés API ».
#    C'est elle qui envoie TOUS les e-mails (par l'API HTTP : fonctionne sur Render gratuit, qui bloque le SMTP).
#    Brevo > Paramètres > Sécurité > IP autorisées : désactive le blocage des IP inconnues (IP Render variables).
BREVO_API_KEY=
# 2) MAIL_FROM : l'EXPÉDITEUR, ce que le client voit dans « De : » quand il reçoit son code après paiement.
#    Doit être une adresse VALIDÉE dans Brevo (Expéditeurs, domaines et IP dédiées > Expéditeurs).
#    Une Gmail validée fonctionne ; une adresse sur ton propre domaine authentifié arrive mieux (moins de spam).
MAIL_FROM="Gift Cards <bokojohannes2@gmail.com>"
# 3) CONTACT_EMAIL : le DESTINATAIRE des formulaires (newsletter/contact). Ta boîte, Gmail accepté.
CONTACT_EMAIL=bokojohannes2@gmail.com
# 4) ADMIN_EMAIL : reçoit les alertes (ex. commande payée mais stock épuisé → remboursement à faire).
ADMIN_EMAIL=bokojohannes2@gmail.com
# Adresse « Répondre à » des e-mails de livraison : config/boutique.config.js > site.serviceClient.email

# SMTP : seulement en secours si BREVO_API_KEY est vide (bloqué sur Render gratuit).
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Newsletter (facultatif) : ajoute aussi les inscrits à une liste Brevo (même BREVO_API_KEY) ---
# N° de la liste : app.brevo.com > Contacts > Lists (ex. 3)
BREVO_LIST_ID=

# --- Stock de codes ---
# Clé de chiffrement des codes (64 caractères hexadécimaux) : npm run generer-cle
# ⚠ Conserve-la : si tu la perds, les codes déjà en stock deviennent illisibles.
CLE_CHIFFREMENT_CODES=
# Emplacement de la base. Sur Render, utilise un disque persistant (ex. /var/data/boutique.sqlite)
DB_PATH=./data/boutique.sqlite

# --- Espace admin (/admin) : table de stock et commandes ---
ADMIN_USER=
# 12 caractères minimum
ADMIN_PASSWORD=

# --- Intégration WordPress ---
# Domaine(s) WordPress autorisé(s) à afficher la boutique en iframe (séparés par des virgules)
FRAME_ANCESTORS=https://www.ton-site-wordpress.fr
# Domaine(s) autorisé(s) à appeler l'API depuis le bloc de paiement intégré
ALLOWED_ORIGINS=https://www.ton-site-wordpress.fr

# --- Stock (codes) chargé automatiquement au démarrage si la base est vide ---
# Ordre de recherche : STOCK_CSV, puis le Secret File Render « stock-initial.csv », puis private/stock-initial.csv.
# STOCK_CSV=/etc/secrets/stock-initial.csv
# STOCK_IMPORT=toujours   ← relit le fichier à chaque démarrage (doublons et codes vendus ignorés)
